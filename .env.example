# ==============================================================================
# .env.example — case-dados-automacao-beneficiarios
# Arquivo de exemplo para configurações locais do ambiente.
# Este projeto utiliza dados 100% sintéticos e SQLite local.
# Nenhuma chave de API, credencial bancária ou token externo é necessária.
# ==============================================================================

# Configurações do Servidor Streamlit (Opcional)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ADDRESS=localhost

# Configurações de Banco de Dados (Opcional - Padrão: data/beneficiarios.db)
# DB_PATH=data/beneficiarios.db
